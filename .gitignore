# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# …but DO commit the template (no secrets in it)
!.env.example

# shipping-facts data (17MB, testing-only per DEV-SHIP-01 — not committed)
/data/shipping-facts-v3.json

# vercel
.vercel

# git worktrees (scratch, per-machine)
/.worktrees/

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright
/test-results/
/playwright-report/
/playwright/.cache/

# manual QA sweep script + screenshots (regenerable, see docs/superpowers/plans QA handoffs)
/qa-sweep.js
/shots/

# lighthouse raw output (regenerable; summarized in audit/*.md)
/audit/lighthouse/
/audit/lighthouse-track-a/
.superpowers/

# Phase 13 responsive capture output — 14MB of regenerable PNGs.
# Regenerate: E2E_BASE_URL=http://localhost:3000 npx playwright test e2e/responsive.spec.ts
docs/audits/2026-08-02-catalog-cro/screenshots/

# Phase 8 bulk migration evidence — ~81k lines, regenerable from
# scripts/industries-mapping-dryrun.mjs + the dated catalog export.
# Committed instead: summary, unmapped, rollback SCHEMA, sha256 checksums.
docs/audits/2026-08-02-catalog-cro/evidence/
