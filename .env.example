# ── MDSupplies environment variables ─────────────────────────────────────────
# Copy to .env.local for development and fill in real values.
# Never commit real secrets. Deployment values live in the Vercel project env.

# ── Site identity ─────────────────────────────────────────────────────────────
# Canonical base URL for every canonical tag, og:url, sitemap entry, JSON-LD
# URL, and llms.txt. Defaults to https://mdsupplies.com when unset.
# PRODUCTION GUARD (lib/site-config.ts): a Vercel production deployment fails
# its build unless this is https://mdsupplies.com or https://www.mdsupplies.com.
# In dev this may be your ngrok tunnel (needed for Shopify login/webhooks).
NEXT_PUBLIC_SITE_URL=https://mdsupplies.com

# Staging override. Usually LEAVE UNSET: staging is auto-derived from Vercel's
# VERCEL_ENV (any non-production deploy is noindexed with a Disallow robots.txt
# and an empty sitemap). Set 'true' to force staging on a production-slot
# deploy that is not yet the live site (pre-domain-cutover); set 'false' to
# force live. Also gates GTM/analytics off while true.
# NEXT_PUBLIC_IS_STAGING=

# ── Shopify Storefront API ────────────────────────────────────────────────────
# Store domain, e.g. your-store.myshopify.com (no protocol).
SHOPIFY_STORE_DOMAIN=
# SHOP GUARD (lib/shopify/shop-guard.ts): the ONE shop this build may reach.
# SHOPIFY_STORE_DOMAIN, the shop the Admin token authenticates against, and the
# shipping registry's _meta.store must all equal this value or the build fails
# closed. Defaults to the QA store when unset, so a CI or Preview environment
# that inherits production Shopify variables cannot quietly connect to the live
# store — reaching production has to be chosen here on purpose.
# SHOPIFY_ALLOWED_SHOP_DOMAIN=md-supplies-qa-shipping-and-checkout.myshopify.com
# Storefront API access token (Headless / custom app → Storefront API).
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
# HMAC secret for verifying Shopify webhooks hitting POST /api/revalidate
# (Shopify admin → Settings → Notifications → Webhooks → shared secret).
SHOPIFY_WEBHOOK_SECRET=
# Admin API credential for the RX prescription gate ONLY (customer metafield
# read/write). Custom Admin app scoped to read_customers + write_customers.
# NOT a static access token: lib/shopify/admin-token.ts exchanges this client
# id/secret pair for a short-lived token via the client_credentials grant
# (POST {store}/admin/oauth/access_token) and caches it for the process.
SHOPIFY_ADMIN_CLIENT_ID=
SHOPIFY_ADMIN_CLIENT_SECRET=

# ── Shopify Customer Accounts (login / orders) ────────────────────────────────
# From the Customer Account API settings of the headless app.
SHOPIFY_CUSTOMER_ACCOUNT_URL=
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=
# Optional; defaults: noreply@mdsupplies.com / support@mdsupplies.com.
# RESEND_FROM_EMAIL=
# RESEND_TO_EMAIL=
# Optional override for sourcing-request notifications.
# RESEND_SOURCING_TO_EMAIL=

# ── BunnyCDN (category banners / product placeholders via /api/bunny) ────────
BUNNYCDN_STORAGE_ACCESS_KEY=
# Optional; defaults: ny.storage.bunnycdn.com / md-supplies.
# BUNNYCDN_STORAGE_HOSTNAME=
# BUNNYCDN_STORAGE_ZONE=

# ── RX document malware scanning (self-hosted ClamAV REST service) ──────────
# Prescription files are PII: NEVER point this at a shared multiscanner like
# VirusTotal. Use a self-hosted ClamAV REST container reachable only by the app
# (e.g. benzino77/clamav-rest-api or ajilaag/clamav-rest).
# RX_SCAN_CLAMAV_URL=
# Optional bearer token if the scan service requires auth.
# RX_SCAN_AUTH_TOKEN=
# 'true' = fail CLOSED (scanner down ⇒ uploads rejected). Leave unset while the
# scanner is being stood up; set to 'true' at launch.
# RX_SCAN_REQUIRED=

# ── Analytics ─────────────────────────────────────────────────────────────────
# Google Tag Manager container id (GTM-XXXXXXX). Omit to disable GTM.
# NEXT_PUBLIC_GTM_ID=

# ── Shipping display resolver (DEV-SHIP-01) ──────────────────────────────────
# Disabled by default and MUST stay disabled in production until wording,
# data, and QA are separately approved. 'true' to enable (dev/staging only).
# SHIPPING_RESOLVER_ENABLED=

# Which registry the resolver loads. It MUST match the shop this build is
# allowed to reach (SHOPIFY_ALLOWED_SHOP_DOMAIN): the registry declares its own
# store in _meta.store and the loader refuses a mismatch, because Shopify GIDs
# are store-specific and a wrong-shop registry misses every lookup while
# appearing to load cleanly.
#
#   QA build         -> data/shipping-facts-qa.json  (committed, synthetic, QA GIDs)
#   production data  -> data/shipping-facts-v3.json  (gitignored; OFFLINE schema and
#                       resolver testing only until production use is separately approved)
#
# Defaults to data/shipping-facts-v3.json.
# SHIPPING_FACTS_PATH=data/shipping-facts-qa.json

# Override for the pinned SHA-256 the resolver validates the data file
# against, only needed when the data file is intentionally replaced.
# SHIPPING_FACTS_CHECKSUM_SHA256=
